# App — production is https://pitchpit.lol
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (test mode recommended)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs — run: npx tsx scripts/setup-stripe-products.ts
STRIPE_PRICE_PIT_ONEDAY=price_...
STRIPE_PRICE_PIT_DAILY=price_...
STRIPE_PRICE_UNDERCARD_ONEDAY=price_...
STRIPE_PRICE_UNDERCARD_DAILY=price_...
STRIPE_PRICE_MAIN_EVENT_ONEDAY=price_...
STRIPE_PRICE_MAIN_EVENT_DAILY=price_...

# Security
CRON_SECRET=generate-a-long-random-string
VISITOR_SECRET=generate-a-long-random-string
IP_HASH_SALT=generate-a-long-random-string
